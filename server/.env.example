# Free Gemini API key (no credit card needed) — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=AI...

# Postgres connection string (Neon, Supabase, Railway, etc). Required — the app has no local
# fallback DB anymore. Local dev and production should point at separate databases.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required in production (the server refuses to start without it there) — session cookies are
# signed with this. Optional for local dev, but still worth setting to something random.
SESSION_SECRET=change-me-to-something-random

# Optional overrides
GEMINI_MODEL=gemini-flash-lite-latest
PORT=4000

# Production only (Render) — the exact URL of your deployed Netlify frontend, no trailing slash.
# NODE_ENV=production
# CLIENT_ORIGIN=https://your-site-name.netlify.app

# Testing only — uncomment to pretend "today" is a fixed date for dashboard countdowns.
# FAKE_TODAY=2025-08-15
